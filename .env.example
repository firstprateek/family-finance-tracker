# Database
DATABASE_PATH=./data/finance.db

# Ollama (local LLM for receipt scanning and categorization)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# Whisper (local speech-to-text for voice entry)
# WHISPER_PATH=/usr/local/bin/whisper-cpp
# WHISPER_MODELS_PATH=/usr/local/share/whisper-cpp/models
# WHISPER_MODEL=small
